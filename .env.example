# ---- LLM / embeddings (Google Gemini) ----
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...

# ---- Web search (optional; Tavily preferred, DuckDuckGo keyless fallback) ----
TAVILY_API_KEY=tvly-...

# ---- LangSmith observability (optional) ----
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=resume-demo-rag-agent
LANGSMITH_ENDPOINT=https://smith.langchain.com

# ---- Models (override defaults if desired | You can use you own desired models) ----
MODEL_FAST=gemini-2.5-flash-lite
MODEL_HEAVY=gemini-2.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001

# ---- Storage / retrieval ----
CHROMA_DIR=./chroma_db
RETRIEVER_K=4
